#requires -Version 5.1
#requires -RunAsAdministrator
[CmdletBinding()]param()
Set-StrictMode -Version Latest
$ErrorActionPreference='Stop'
try {
 $common=Join-Path $PSScriptRoot 'Yhteiset.ps1'
 if((Get-FileHash -LiteralPath $common -Algorithm SHA256).Hash -ne '__COMMON_SHA__'){throw 'Paketin Yhteiset.ps1-tarkistussumma ei tasmaa.'}
 . $common
 Initialize-UiUpdate
 $checked=Invoke-UiUpdate 'check'
 if($checked.already){Write-Host 'Tuntien ulkoasu 1.4 on jo asennettu. Mitaan ei muutettu.' -ForegroundColor Green;exit 0}
 Assert-UiEnvironment
 Write-Host 'Paivitetaan Tuntien selainosa. Palvelut jatkavat kaynnissa.'
 $backups='C:\TJT\Varmuuskopiot\TJT-Portaali-v1'
 $result=Invoke-UiUpdate 'apply' $backups
 Write-Host 'VALMIS: TJT Tunnit, yhteinen ulkoasu 1.4.' -ForegroundColor Green
 Write-Host ('Aiemmat ohjelmatiedostot: '+$result.backup)
 Write-Host 'Paivita Tuntien sivu Ctrl+F5. Puhelimella sulje Tuntien valilehti ja avaa se portaalista uudelleen.'
 Write-Host 'Tuntikirjaukset, hyvaksyntatiedot, kayttooikeudet ja varmuuskopiointiajastukset sailyivat.'
} catch {Write-Host $_.Exception.Message -ForegroundColor Red;exit 1}
